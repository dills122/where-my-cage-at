{
	"name": "data-service",
	"version": "0.1.5",
	"description": "",
	"scripts": {
		"test": "TS_NODE_PREFER_TS_EXTS=true node --test --require ts-node/register src/*.spec.ts",
		"build": "tsc -p .",
		"watch": "tsc -p . --watch",
		"compile": "tsc",
		"clean": "tsc --build --clean && rm -rf ./types",
		"refresh": "ts-node ./refresh-runner.ts",
		"refresh:static": "ts-node ./static-refresh-runner.ts",
		"start": "node refresh-runner.js",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix"
	},
	"dependencies": {
		"@dills1220/tmdb": "2.7.2",
		"dotenv": "~16.0.3",
		"@dills1220/wtw": "workspace:*",
		"redis-sdk": "workspace:*",
		"got": "11.8.2"
	},
	"devDependencies": {
		"@types/node": "^18.11.7",
		"@typescript-eslint/eslint-plugin": "5.62.0",
		"@typescript-eslint/parser": "5.62.0",
		"eslint": "~8.57.1",
		"ts-node": "~10.9.1",
		"typescript": "~4.7.3"
	},
