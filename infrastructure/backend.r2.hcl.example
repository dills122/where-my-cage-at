# Non-secret partial backend configuration for Cloudflare R2. Copy this file to
# backend.r2.hcl, replace placeholders, and keep the copy out of source control.
bucket = "where-my-cage-at-tofu-state"
key    = "where-my-cage-at/production.tfstate"
region = "auto"

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true

endpoints = {
  s3 = "https://replace-with-account-id.r2.cloudflarestorage.com"
}
